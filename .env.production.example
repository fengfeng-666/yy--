# 复制为 .env.production 后再填写。不要把真实密钥提交到 Git。
APP_NAME=YY私厨
APP_ENV=production
DEBUG=false

POSTGRES_DB=yy_kitchen
POSTGRES_USER=yy_kitchen
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# 至少 32 字节，推荐执行 openssl rand -hex 32 生成
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_HEX_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

MAX_UPLOAD_SIZE_MB=10
# 前端通过 Nginx 同源访问 API，默认不需要跨域来源
CORS_ORIGINS=[]

# 宿主机对外端口；生产环境建议由 HTTPS 负载均衡或反向代理接入
APP_PORT=80
UVICORN_WORKERS=2
