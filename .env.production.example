# 复制为 .env.production 后再填写。不要把真实密钥提交到 Git。
APP_NAME=YY私厨
APP_ENV=production
DEBUG=false

POSTGRES_DB=yy_kitchen
POSTGRES_USER=yy_kitchen
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# 至少 32 字节，推荐执行 openssl rand -hex 32 生成
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_HEX_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

MAX_UPLOAD_SIZE_MB=10
# 前端通过 Nginx 同源访问 API，默认不需要跨域来源
CORS_ORIGINS=[]

# Caddy 自动申请 HTTPS 证书。域名购买后如有变化，在这里替换。
ROOT_DOMAIN=yykitchen.xyz
WEB_DOMAIN=www.yykitchen.xyz
API_DOMAIN=api.yykitchen.xyz
ACME_EMAIL=your-email@example.com
UVICORN_WORKERS=2

# 微信小程序登录与订阅消息
WECHAT_ENABLED=false
WECHAT_APP_ID=wx159752e659deda15
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_NEW_ORDER=
WECHAT_TEMPLATE_ORDER_ACCEPTED=
