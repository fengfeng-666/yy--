APP_NAME=YY私厨
APP_ENV=development
DEBUG=true

# 如果填写 DATABASE_URL，将优先覆盖下面的拆分配置
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/yy_kitchen
DB_HOST=localhost
DB_PORT=5433
DB_NAME=yy_kitchen
DB_USER=postgres
DB_PASSWORD=password

# 生产环境请使用至少 32 字节的随机值，例如：openssl rand -hex 32
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

CORS_ORIGINS=["http://localhost:5174"]

AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=mimo-v2.5
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=60
AI_MAX_HISTORY_MESSAGES=12
AI_VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=data/chroma
PGVECTOR_TABLE_PREFIX=yy_ai
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.1

# 微信小程序。AppSecret 只放服务端环境变量，不要提交到 Git 或写入小程序代码。
WECHAT_APP_ID=wx159752e659deda15
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_NEW_ORDER=
WECHAT_TEMPLATE_ORDER_ACCEPTED=
